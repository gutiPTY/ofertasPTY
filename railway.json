{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm --filter @ofertaspty/database run generate && pnpm --filter @ofertaspty/api run build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @ofertaspty/api run start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
