# packages/database/.env
# connection_limit=1 esta bien aca: son scripts CLI (migrate/seed/etc) que
# corren de a uno, no un servidor con requests concurrentes.
DATABASE_URL=              # Supabase connection pooler, puerto 6543, ?pgbouncer=true&connection_limit=1
DIRECT_URL=                # Supabase conexion directa, puerto 5432 (usada solo por prisma migrate)

# apps/api/.env
# Mismo pooler, pero connection_limit mas alto (ej. 10): apps/api es un
# proceso persistente que atiende requests concurrentes: con limit=1 cualquier
# fetch en paralelo (ej. el feed pidiendo /ofertas y /categorias a la vez)
# agota la unica conexion y todo lo demas espera hasta el timeout (P2024).
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=       # opcional hasta Fase 1 (subida de imagenes)
CORS_ORIGINS=http://localhost:3000  # lista separada por comas (agregar la URL de Vercel en produccion)
PORT=3001
# Nota: este proyecto firma JWT con signing keys asimetricas (JWKS), no con
# secreto compartido, asi que no hace falta JWT_SECRET aqui.

# apps/web/.env.local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3001

# apps/mobile/.env
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=http://localhost:3001
