# apps/api/.env.test — Postgres LOCAL dedicada a tests, nunca produccion.
# Ver TESTING.md para como crear el rol/DB una sola vez.
DATABASE_URL=postgresql://ofertaspty_test:<password-local>@localhost:5432/ofertaspty_test

# Estas 3 SI son las credenciales reales de Supabase (mismo proyecto que
# produccion) — los tests crean/loguean/borran usuarios reales via Auth
# Admin API porque no hay stack de Supabase local. Copiar tal cual desde
# apps/api/.env.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_STORAGE_BUCKET=
CORS_ORIGINS=http://localhost:3000
PORT=3001
NODE_ENV=test
WEB_URL=http://localhost:3000
# RESEND_API_KEY a proposito NO se define aca: sin ella, lib/email.ts
# loguea en vez de enviar — los tests no mandan emails reales.
EMAIL_FROM=onboarding@resend.dev
